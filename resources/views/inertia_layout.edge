<!DOCTYPE html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-inertia>
      ABAS Inmobiliaria
    </title>

    {{-- Iconos: generados desde la marca del logo (edificios + swoosh).
         El .ico del sitio viejo era 256x103 y pesaba 108 KB. --}}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#4271AE" />

    <link rel="preload" href="/fonts/montserrat-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/nunito-sans-var.woff2" as="font" type="font/woff2" crossorigin />

    @viteReactRefresh({ nonce: cspNonce })
    @vite(['inertia/app.tsx'], { nonce: cspNonce })
    @inertiaHead()
    @stack('dumper')
  </head>

  <body>
    @inertia()
  </body>

</html>
