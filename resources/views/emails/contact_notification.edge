<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nueva consulta del sitio</title>
  </head>
  <body style="margin:0;padding:0;background-color:#f7f9fc;font-family:Arial,Helvetica,sans-serif;color:#1f2733;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f7f9fc;padding:24px 0;">
      <tr>
        <td align="center">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #dde5ef;">
            <tr>
              <td style="background:linear-gradient(135deg,#6a822b,#55691f);background-color:#6a822b;padding:24px 32px;">
                <span style="font-size:22px;font-weight:800;color:#ffffff;letter-spacing:2px;">PROPAR</span>
                <span style="font-size:13px;color:#eef2e4;display:block;">Nueva consulta desde propar.com.py</span>
              </td>
            </tr>
            <tr>
              <td style="padding:32px;">
                <h1 style="margin:0 0 16px;font-size:18px;color:#1f2733;">{{ asuntoEtiqueta }}</h1>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;line-height:1.6;">
                  <tr>
                    <td style="padding:6px 12px 6px 0;color:#64748b;white-space:nowrap;vertical-align:top;">Nombre</td>
                    <td style="padding:6px 0;">{{ nombre }} {{ apellido }}</td>
                  </tr>
                  <tr>
                    <td style="padding:6px 12px 6px 0;color:#64748b;white-space:nowrap;vertical-align:top;">Teléfono</td>
                    <td style="padding:6px 0;">{{ telefono }}</td>
                  </tr>
                  <tr>
                    <td style="padding:6px 12px 6px 0;color:#64748b;white-space:nowrap;vertical-align:top;">Correo</td>
                    <td style="padding:6px 0;">{{ correo }}</td>
                  </tr>
                  @if(fraccionCodigo)
                    <tr>
                      <td style="padding:6px 12px 6px 0;color:#64748b;white-space:nowrap;vertical-align:top;">Fracción</td>
                      <td style="padding:6px 0;">Nº {{ fraccionCodigo }}</td>
                    </tr>
                  @end
                </table>
                <p style="margin:16px 0 4px;font-size:13px;color:#64748b;">Consulta:</p>
                <p style="margin:0;padding:12px 16px;background:#f7f9fc;border:1px solid #dde5ef;border-radius:8px;font-size:14px;line-height:1.6;white-space:pre-wrap;">{{ consulta }}</p>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 32px;background:#f7f9fc;border-top:1px solid #dde5ef;">
                <p style="margin:0;font-size:12px;color:#64748b;">
                  Podés responder este correo directamente: la respuesta va al visitante.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
