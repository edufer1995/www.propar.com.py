<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Solicitud de compra de lote</title>
  </head>
  <body style="margin:0;padding:0;background-color:#f7f9fc;font-family:Arial,Helvetica,sans-serif;color:#1f2733;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f7f9fc;padding:24px 0;">
      <tr>
        <td align="center">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #dde5ef;">
            <tr>
              <td style="background:linear-gradient(135deg,#99cd68,#7db34a);background-color:#7db34a;padding:24px 32px;">
                <span style="font-size:22px;font-weight:800;color:#ffffff;letter-spacing:2px;">ABAS</span>
                <span style="font-size:13px;color:#f2f8ec;display:block;">Solicitud de compra desde abas.com.py</span>
              </td>
            </tr>
            <tr>
              <td style="padding:32px;">
                <h1 style="margin:0 0 16px;font-size:18px;color:#1f2733;">
                  Lote {{ fml }} — {{ fraccionDescripcion }}
                </h1>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;line-height:1.6;">
                  <tr>
                    <td style="padding:6px 12px 6px 0;color:#64748b;white-space:nowrap;vertical-align:top;">Nombre</td>
                    <td style="padding:6px 0;">{{ nombre }}</td>
                  </tr>
                  <tr>
                    <td style="padding:6px 12px 6px 0;color:#64748b;white-space:nowrap;vertical-align:top;">Teléfono</td>
                    <td style="padding:6px 0;">{{ telefono }}</td>
                  </tr>
                  <tr>
                    <td style="padding:6px 12px 6px 0;color:#64748b;white-space:nowrap;vertical-align:top;">F-M-L</td>
                    <td style="padding:6px 0;">{{ fml }}</td>
                  </tr>
                  <tr>
                    <td style="padding:6px 12px 6px 0;color:#64748b;white-space:nowrap;vertical-align:top;">Superficie</td>
                    <td style="padding:6px 0;">{{ superficie }}</td>
                  </tr>
                  <tr>
                    <td style="padding:6px 12px 6px 0;color:#64748b;white-space:nowrap;vertical-align:top;">Plazos</td>
                    <td style="padding:6px 0;">{{ plazos }}</td>
                  </tr>
                  <tr>
                    <td style="padding:6px 12px 6px 0;color:#64748b;white-space:nowrap;vertical-align:top;">Cuota mensual</td>
                    <td style="padding:6px 0;">{{ mensual }}</td>
                  </tr>
                  <tr>
                    <td style="padding:6px 12px 6px 0;color:#64748b;white-space:nowrap;vertical-align:top;">Precio crédito</td>
                    <td style="padding:6px 0;">{{ credito }}</td>
                  </tr>
                </table>
                @if(comentario)
                  <p style="margin:16px 0 4px;font-size:13px;color:#64748b;">Comentario:</p>
                  <p style="margin:0;padding:12px 16px;background:#f7f9fc;border:1px solid #dde5ef;border-radius:8px;font-size:14px;line-height:1.6;white-space:pre-wrap;">{{ comentario }}</p>
                @end
              </td>
            </tr>
            <tr>
              <td style="padding:16px 32px;background:#f7f9fc;border-top:1px solid #dde5ef;">
                <p style="margin:0;font-size:12px;color:#64748b;">
                  Los precios son el snapshot del ERP al momento del pedido y quedaron guardados en el lead.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
