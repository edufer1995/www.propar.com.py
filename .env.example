# Node
TZ=UTC
PORT=3334
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=abas_v2
# Base con el restore del dump viejo (solo para `node ace etl:import`)
# DB_DATABASE_STAGING=abas_staging
DB_SSL=false
# DB_SSL_STRICT=true

# URL para el MCP de postgres (.mcp.json) — mismas credenciales que arriba
DATABASE_URL=postgresql://postgres:CAMBIAR@127.0.0.1:5432/abas_v2

# ERP — 'fake' para desarrollo (dataset inventado, no requiere ERP),
# 'odoo' para el Odoo de Propar (exige las ODOO_*), 'oracle' para las vistas Oracle (exige las ORACLE_*)
ERP_DRIVER=fake
# ODOO_URL=https://propar-preprod-1111-41705043.dev.odoo.com
# ODOO_DB=propar-preprod-1111-41705043
# ODOO_LOGIN=
# ODOO_API_KEY=          # Odoo → Preferencias → Seguridad de la cuenta → Nueva clave API
# ODOO_TIMEOUT_MS=30000
# ORACLE_HOST=
# ORACLE_PORT=1521
# ORACLE_USER=
# ORACLE_PASSWORD=
# ORACLE_DB_NAME=

# SMTP — en desarrollo usar Mailpit (http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Correos del negocio
MAIL_FROM=no-responder@abas.com.py
MAIL_FROM_NAME=Your name
CONTACTO_EMAIL=contacto@abas.com.py
VENTAS_EMAIL=ventas@abas.com.py

# Archivos subidos (ruta absoluta o relativa a la raíz del proyecto)
UPLOADS_PATH=./storage/uploads

# Google Maps (se comparte al frontend; restringir por referrer en Google Cloud)
GOOGLE_MAPS_API_KEY=

# Rate limiter
LIMITER_STORE=database
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=app@yourdomain.com
DRIVE_DISK=fs
# Nombre visible de la app (frontend)
VITE_APP_NAME="ABAS Inmobiliaria"

# WhatsApp de ventas (botón "Consultar por WhatsApp" del mapa)
WHATSAPP_VENTAS=+59521444061
